# Локальный оверрайд для запуска через .venv (manage.py runserver) вне Docker.
# Не коммитится (см. .gitignore) и не попадает в образ (см. .dockerignore).
DJANGO_DEBUG=true
DJANGO_DB_HOST=localhost

# Все хосты через точку с запятой
DJANGO_ALLOWED_HOSTS=shubnikov.me;www.shubnikov.me;admin.shubnikov.me;shop.shubnikov.me;localhost;127.0.0.1

# CSRF — все origins через точку с запятой
DJANGO_CSRF_TRUSTED_ORIGINS=https://shubnikov.me;https://www.shubnikov.me;https://admin.shubnikov.me;https://shop.shubnikov.me

# Субдомены для middleware
DJANGO_ADMIN_HOST=admin.shubnikov.me
DJANGO_SHOP_HOST=shop.shubnikov.me
